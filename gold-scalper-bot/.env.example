# Copy this file to .env and fill in real values. Never commit .env.

# Shared secret that TradingView must include in every webhook payload.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Token required to open the dashboard: /?token=...
DASHBOARD_TOKEN=change-me-too

# Optional Telegram alerts. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Host/port for the web server.
HOST=0.0.0.0
PORT=8000

# --- Real broker credentials (only needed when you switch off paper mode) ---
# OANDA example:
# OANDA_API_TOKEN=
# OANDA_ACCOUNT_ID=
# OANDA_ENV=practice
